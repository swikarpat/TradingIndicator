// ICT NWOG/NDOG & ICT NY Midnight Open, ICT RTH Gap
// © SwikarP

//@version=6
indicator("TradingIndicator", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500, max_polylines_count=100)

// --- Types & Helpers ---
type GapObject
    box b
    line ln
    label lbl

type PolyStream
    chart.point[] pts
    polyline[] frozen
    polyline live

f_del_gap(GapObject g) =>
    if not na(g)
        box.delete(g.b), line.delete(g.ln)
        if not na(g.lbl)
            label.delete(g.lbl)

// --- Settings ---
i_showMas  = input.bool(false, "Show EMA/SMA")
i_smaColor = input.color(#42bda8, "SMA", inline="sma_main"), i_smaLen = input.int(200, minval=1, title="", inline="sma_main")
i_emaColor = input.color(#5b9cf6, "EMA", inline="ema_main"), i_emaLen = input.int(50, minval=1, title="", inline="ema_main")
i_showBias = input.bool(true, "Show Sentiment Badge")
i_showNwog = input.bool(true, "Show NWOG")
i_showNdog = input.bool(true, "Show NDOG")
i_showRthg = input.bool(true, "Show Regular Trading Hours Gap")
i_showNy   = input.bool(true, "Show NY Midnight Open")
i_offset   = input.int(50, "Label Offset (Bars)")

color c_nwog = color.new(#2962ff, 90), color c_ndog = color.new(#ba68c8, 90)
color c_rthg = color.new(#00b9d0, 90), color c_rthg_l = #00b9d0, color c_rthg_t = #008f9c

// --- HTF Data Fetchers (1 stream per timeframe, O(1) updates per bar) ---
f_record_gap(float[] tops, float[] btms, int[] tms, float prev_c, float curr_o, int tm, int max_n) =>
    float top = math.max(prev_c, curr_o), float btm = math.min(prev_c, curr_o)
    if top != btm
        array.unshift(tops, top), array.unshift(btms, btm), array.unshift(tms, tm)
        if array.size(tops) > max_n
            array.pop(tops), array.pop(btms), array.pop(tms)

f_fetch_w() =>
    var tops = array.new<float>(), var btms = array.new<float>(), var tms = array.new<int>()
    if not na(close[1])
        f_record_gap(tops, btms, tms, close[1], open, time, 5)
    [tops, btms, tms]

f_fetch_d() =>
    var tops = array.new<float>(), var btms = array.new<float>(), var tms = array.new<int>()
    float ema20 = ta.ema(close, 20)
    if not na(close[1])
        f_record_gap(tops, btms, tms, close[1], open, time, 5)
    [tops, btms, tms, open, ema20]

f_fetch_15m() =>
    var tops = array.new<float>(), var btms = array.new<float>(), var tms = array.new<int>()
    var float prev_c = na, var float ny_open = na
    bool in_r = not na(time(timeframe.period, "0930-1615:23456", "America/New_York"))
    if in_r[1] and not in_r
        prev_c := close[1]
    if in_r and not in_r[1] and not na(prev_c)
        f_record_gap(tops, btms, tms, prev_c, open, time, 6)
    bool in_mid = not na(time(timeframe.period, "0000-0015:1234567", "America/New_York"))
    if in_mid and not in_mid[1]
        ny_open := open
    [tops, btms, tms, ta.ema(close, 20), ta.atr(14), ny_open]

[w_tops, w_btms, w_tms]                              = request.security(syminfo.tickerid, "W",  f_fetch_w(), lookahead=barmerge.lookahead_off)
[d_tops, d_btms, d_tms, d_open, d_ema20]             = request.security(syminfo.tickerid, "D",  f_fetch_d(), lookahead=barmerge.lookahead_off)
[h1_ema, h1_sma]                                     = request.security(syminfo.tickerid, "60", [ta.ema(close, i_emaLen), ta.sma(close, i_smaLen)], lookahead=barmerge.lookahead_off)
[r_tops, r_btms, r_tms, m15_ema, m15_atr, ny_15m]    = request.security(syminfo.tickerid, "15", f_fetch_15m(), lookahead=barmerge.lookahead_off)

// --- Gap & Anchor Drawing Engine (draws only at barstate.islast on real changes) ---
bool show_draws = not timeframe.isdwm
var nwog_gaps = array.new<GapObject>(), var ndog_gaps = array.new<GapObject>(), var rthg_gaps = array.new<GapObject>()
var ehpda_lvls = array.new<line>(), var ehpda_lbls = array.new<label>()
var int last_w_t = 0, var int last_d_t = 0, var int last_r_t = 0, var int last_off_t = 0
var label ny_lbl = label.new(na, na, "", xloc=xloc.bar_time, yloc=yloc.price, color=color(na), style=label.style_label_left, textcolor=#0098ff, size=size.tiny)

f_draw_gaps(GapObject[] out, float[] tops, float[] btms, int[] tms, int max_n, color bg, color bcol, color lcol, int bw, bool is_rth, int off_t) =>
    for g in out
        f_del_gap(g)
    array.clear(out)
    if not na(tops) and not na(btms) and not na(tms)
        int n = math.min(max_n, array.size(tops))
        if n > 0
            for i = 0 to n - 1
                float top = array.get(tops, i), float btm = array.get(btms, i), int tm = array.get(tms, i), float avg = math.avg(top, btm)
                bool hide_box = is_rth and i > 0
                box bx = box.new(tm, top, tm + 1, btm, xloc=xloc.bar_time, extend=extend.right, bgcolor=hide_box ? color(na) : bg, border_color=(hide_box or bw == 0) ? color(na) : bcol, border_width=bw)
                line ln = line.new(tm, avg, tm + 1, avg, xloc=xloc.bar_time, extend=extend.right, color=lcol, style=line.style_dashed, width=1)
                label lb = na
                if is_rth
                    int d = dayofweek(tm, "America/New_York")
                    string ds = d == dayofweek.monday ? "MON" : d == dayofweek.tuesday ? "TUE" : d == dayofweek.wednesday ? "WED" : d == dayofweek.thursday ? "THU" : d == dayofweek.friday ? "FRI" : ""
                    if ds != ""
                        lb := label.new(off_t, avg, "RTHG " + ds + "/" + str.format_time(tm, "dd", "America/New_York"), xloc=xloc.bar_time, yloc=yloc.price, color=color(na), style=label.style_label_left, textcolor=c_rthg_t, size=size.tiny)
                array.push(out, GapObject.new(bx, ln, lb))

int nmid = time("1", "0000-0001:1234567", "America/New_York")
var float openprice = 0.0
if not na(nmid) and na(nmid[1])
    openprice := open
    if i_showNy and show_draws
        line.new(nmid, openprice, nmid + 86400000, openprice, xloc=xloc.bar_time, extend.none, #0064ff, line.style_dotted, 2)
        label.set_y(ny_lbl, openprice), label.set_text(ny_lbl, "NY Midnight Open | " + str.tostring(math.round_to_mintick(openprice)))
        if high != low
            line.new(nmid, high, nmid, low, xloc=xloc.bar_time, extend.both, #00b9d0, line.style_solid, 1)

if barstate.islast and show_draws
    int off_t = time + i_offset * timeframe.in_seconds() * 1000
    int w0 = (not na(w_tms) and array.size(w_tms) > 0) ? array.get(w_tms, 0) : na
    if i_showNwog and not na(w0) and w0 != last_w_t
        f_draw_gaps(nwog_gaps, w_tops, w_btms, w_tms, 5, c_nwog, c_nwog, c_nwog, 1, false, off_t)
        last_w_t := w0
    int d0 = (not na(d_tms) and array.size(d_tms) > 0) ? array.get(d_tms, 0) : na
    if i_showNdog and not na(d0) and d0 != last_d_t
        f_draw_gaps(ndog_gaps, d_tops, d_btms, d_tms, 5, c_ndog, c_ndog, c_ndog, 1, false, off_t)
        for l in ehpda_lvls
            line.delete(l)
        for lb in ehpda_lbls
            label.delete(lb)
        array.clear(ehpda_lvls), array.clear(ehpda_lbls)
        if array.size(ndog_gaps) > 1
            float[] avgs = array.new<float>()
            for g in ndog_gaps
                array.push(avgs, (box.get_top(g.b) + box.get_bottom(g.b)) * 0.5)
            int[] idx = array.sort_indices(avgs)
            for i = 0 to array.size(ndog_gaps) - 2
                GapObject g1 = array.get(ndog_gaps, array.get(idx, i)), GapObject g2 = array.get(ndog_gaps, array.get(idx, i + 1))
                float e_avg = math.avg(box.get_top(g1.b), box.get_bottom(g2.b))
                array.push(ehpda_lvls, line.new(line.get_x1(g1.ln), e_avg, off_t, e_avg, xloc=xloc.bar_time, extend=extend.none, color=#787b86, style=line.style_dashed))
                array.push(ehpda_lbls, label.new(off_t, e_avg, "EHPDA", xloc=xloc.bar_time, yloc=yloc.price, color=color(na), style=label.style_label_left, textcolor=#787b86, size=size.tiny))
        last_d_t := d0
    int r0 = (not na(r_tms) and array.size(r_tms) > 0) ? array.get(r_tms, 0) : na
    if i_showRthg and not na(r0) and r0 != last_r_t
        f_draw_gaps(rthg_gaps, r_tops, r_btms, r_tms, 6, c_rthg, c_rthg, c_rthg_l, 0, true, off_t)
        last_r_t := r0
    if last_off_t != time
        for g in rthg_gaps
            if not na(g.lbl)
                label.set_x(g.lbl, off_t)
        for l in ehpda_lvls
            line.set_x2(l, off_t)
        for lb in ehpda_lbls
            label.set_x(lb, off_t)
        if i_showNy
            label.set_x(ny_lbl, off_t)
        last_off_t := time

// --- SMA & EMA Chunked Polyline Engine (O(1) per bar, zero array.shift copies) ---
float sma_out = ta.sma(close, i_smaLen), float ema_out = ta.ema(close, i_emaLen)
var sma_ps = PolyStream.new(array.new<chart.point>(), array.new<polyline>(), na)
var ema_ps = PolyStream.new(array.new<chart.point>(), array.new<polyline>(), na)

f_update_poly(PolyStream ps, float val, color col) =>
    if i_showMas
        if not na(val)
            array.push(ps.pts, chart.point.from_time(time, val))
            if array.size(ps.pts) >= 1000
                array.push(ps.frozen, polyline.new(ps.pts, curved=false, closed=false, xloc=xloc.bar_time, line_color=col, line_style=line.style_solid, line_width=1))
                if array.size(ps.frozen) > 25
                    polyline.delete(array.shift(ps.frozen))
                chart.point tail = array.get(ps.pts, array.size(ps.pts) - 1)
                array.clear(ps.pts), array.push(ps.pts, tail)
        if barstate.islast
            if not na(ps.live)
                polyline.delete(ps.live)
                ps.live := na
            if array.size(ps.pts) > 1
                ps.live := polyline.new(ps.pts, curved=false, closed=false, xloc=xloc.bar_time, line_color=col, line_style=line.style_solid, line_width=1)

f_update_poly(sma_ps, sma_out, i_smaColor)
f_update_poly(ema_ps, ema_out, i_emaColor)
plot(i_showMas ? sma_out : na, title="SMA", color=i_smaColor, display=display.price_scale)
plot(i_showMas ? ema_out : na, title="EMA", color=i_emaColor, display=display.price_scale)

// --- Market Sentiment Banner ---
var table bias_tbl = table.new(position.top_right, 1, 1, bgcolor=color(na), border_width=0)

f_latest_ce(float[] tops, float[] btms) =>
    float ce = na
    if not na(tops) and not na(btms)
        if array.size(tops) > 0 and array.size(btms) > 0
            ce := math.avg(array.get(tops, 0), array.get(btms, 0))
    ce

f_score(float lvl, string lbl, string sfx) =>
    if not na(lvl)
        bool b = close >= lvl
        [b ? 1 : -1, 1, b ? 1 : 0, barstate.islast ? ("• " + lbl + " (" + str.tostring(math.round_to_mintick(lvl)) + "): " + (b ? "Bullish" : "Bearish") + sfx + "\n") : ""]
    else
        [0, 0, 0, ""]

float ny_mid_val = openprice > 0 ? openprice : ny_15m
string x_info = (not na(h1_ema) and not na(h1_sma)) ? (h1_ema >= h1_sma ? " (Golden)" : " (Death)") : ""
[s_1d, ok_1d, b_1d, t_1d] = f_score(d_ema20, "1D 20 EMA", "")
[s_he, ok_he, b_he, t_he] = f_score(h1_ema, "1H " + str.tostring(i_emaLen) + " EMA", "")
[s_hs, ok_hs, b_hs, t_hs] = f_score(h1_sma, "1H " + str.tostring(i_smaLen) + " SMA", x_info)
[s_15, ok_15, b_15, t_15] = f_score(m15_ema, "15m 20 EMA", "")
[s_6p, ok_6p, b_6p, t_6p] = f_score(d_open, "Globex 6PM", "")
[s_ny, ok_ny, b_ny, t_ny] = f_score(ny_mid_val, "NY Midnight", "")
[s_nw, ok_nw, b_nw, t_nw] = f_score(f_latest_ce(w_tops, w_btms), "Active NWOG", "")
[s_nd, ok_nd, b_nd, t_nd] = f_score(f_latest_ce(d_tops, d_btms), "Active NDOG", "")

int htf_s = s_1d + s_he + s_hs, int htf_n = ok_1d + ok_he + ok_hs
int tf_b  = b_1d + b_he + b_hs + b_15, int tf_n = ok_1d + ok_he + ok_hs + ok_15, int tf_r = tf_n - tf_b
int ic_b  = b_6p + b_ny + b_nw + b_nd, int ic_n = ok_6p + ok_ny + ok_nw + ok_nd, int ic_r = ic_n - ic_b
int bias_score = s_1d + s_he + s_hs + s_15 + s_6p + s_ny + s_nw + s_nd
int tot_n = tf_n + ic_n, int tot_b = tf_b + ic_b, int tot_r = tf_r + ic_r

if barstate.islast
    table.clear(bias_tbl, 0, 0, 0, 0)
    if i_showBias and tot_n > 0
        int hi = math.max(2, tot_n - 2), int mid = math.max(2, tot_n - 4)
        string lbl = "NEUTRAL", color col = #5d606b
        if bias_score >= hi
            lbl := "STRONG BULL", col := #089981
        else if bias_score >= mid
            lbl := "BULLISH", col := #089981
        else if bias_score > 0
            lbl := "LEAN BULL", col := #496e62
        else if bias_score <= -hi
            lbl := "STRONG BEAR", col := #f23645
        else if bias_score <= -mid
            lbl := "BEARISH", col := #f23645
        else if bias_score < 0
            lbl := "LEAN BEAR", col := #8a4a52
        string sc = (bias_score > 0 ? "+" : "") + str.tostring(bias_score) + "/" + str.tostring(tot_n)
        float sep = not na(m15_atr) ? m15_atr * 0.25 : 0.0
        bool has_m = not na(m15_ema) and not na(ny_mid_val)
        string sn = "⚖️ Normal: Mixed conditions. Standard mean-reversion rules apply."
        if bias_score >= hi
            sn := "🟢 Strong bullish run (" + sc + "). Avoid heavy shorts!"
        else if bias_score <= -hi
            sn := "🔴 Strong bearish run (" + sc + "). Avoid heavy longs!"
        else if has_m and close < m15_ema and close >= ny_mid_val and (m15_ema - ny_mid_val) >= sep
            sn := "🔴 Prime Short: 15m momentum crack above midnight open."
        else if has_m and close > m15_ema and close <= ny_mid_val and (ny_mid_val - m15_ema) >= sep
            sn := "🟢 Prime Long: 15m momentum shift below midnight open."
        else if htf_n >= 2 and htf_s < 0 and bias_score > 0
            sn := "⚠️ Counter-Trend Bounce: Intraday bullish vs HTF downtrend. Watch resistance!"
        else if htf_n >= 2 and htf_s > 0 and bias_score < 0
            sn := "⚠️ Counter-Trend Pullback: Intraday bearish vs HTF uptrend. Watch support!"
        string tip = "─── MARKET SENTIMENT ───\nVerdict: " + lbl + " (" + sc + " | " + str.tostring(tot_b) + " Bull / " + str.tostring(tot_r) + " Bear)\n──────────────────\nTIMEFRAME ALIGNMENT (" + str.tostring(tf_b) + " Bull / " + str.tostring(tf_r) + " Bear):\n" + t_1d + t_he + t_hs + t_15 + "──────────────────\nICT ANCHORS (" + str.tostring(ic_b) + " Bull / " + str.tostring(ic_r) + " Bear):\n" + t_6p + t_ny + t_nw + t_nd + "──────────────────\nSAFETY SWITCH:\n" + sn
        table.cell(bias_tbl, 0, 0, lbl + " (" + sc + ")", text_color=color.white, text_size=size.normal, bgcolor=col, tooltip=tip)

plot(bias_score, title="Market Sentiment Score", display=display.data_window)
